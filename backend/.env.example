SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Keep this secret on the backend only. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_OR_SERVICE_ROLE_KEY
# Comma-separated Auth accounts authorized to administer inquiries.
ADMIN_EMAILS=admin@example.com
# Comma-separated exact frontend origins; no wildcard in production.
# Add the exact deployed frontend origin, comma-separated; no wildcard in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.example
